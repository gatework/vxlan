# 已有进程环境优先；密码中的 #、$ 请用单引号包裹。
# NC_DEVICE_USERNAME=operator
# NC_DEVICE_PASSWORD='replace-me'
# NC_ENABLE_PASSWORD='replace-me'
# 可用 SSH key/agent 时不要求密码；用户名必须明确。
# NC_CISCO_NXOS_USERNAME=operator
# NC_CISCO_NXOS_PASSWORD='replace-me'
# VXLAN_CONFIG=vxlan.yml
# VXLAN_FABRIC=default
# VXLAN_PARALLEL=4
# VXLAN_DIRECTORY=vxlans
# 使用 Netdisco 时，其凭据遵循 net-connector 的 ND_* 环境约定。
