/.bundle/
/Gemfile.lock
/pkg/
/*.gem
/coverage/
/spec/examples.txt

# 原始设备回显、日志与本地凭据仅留在本机。
*.log
.env
.env.*
!.env.example
*.pem
*.key
/credentials*
/secrets/
/storage/
/tmp/
.DS_Store

# 现场采集配置与逐设备报告不进入 Git 或安装包。
/examples/vxlan.yml
/examples/vxlans/

# 正式 CLI 在源码目录运行时的默认现场文件。
/vxlan.yml
/vxlans/

# 在 bin/ 启动正式命令时的现场配置及报告。
/bin/vxlan.yml
/bin/fabric-policy.yml
/bin/vxlans/
.cache/
